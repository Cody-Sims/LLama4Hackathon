# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
debug.log
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Transcribe temporary files
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.tmp
*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VSCode
.vscode/

# Node.js
node_modules/

# Environment variables
.env
.env.*

# Python virtual environments
venv/
.venv/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Misc
*.swp
*.swo
*~

# Ignore output files
*.txt
!README.md
!FRONTEND_IMPLEMENTATION_PLAN.md
!BACKEND_IMPLEMENTATION_PLAN.md
!FRONTEND_IMPROVEMENT_PLAN.md
